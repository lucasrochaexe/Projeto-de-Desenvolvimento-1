{
  "expo": {
    "name": "Dexter",
    "slug": "Dexter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LogoEscurofundo 2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
        "package": "com.brunocorreas.Dexter",
        "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logoEscuro.png",
        "monochromeImage": "./assets/logoBranco.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./src/img/oppen.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#111111"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["./src/utilidade/sound/bip.mp3"]
        }
      ],
      [
        "expo-audio",
        {
          "sounds": ["./src/utilidade/sound/bip.mp3"],
          "microphonePermission": "Permitir que o aplicativo acesse o microfone para gravar áudio."
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "01cbb433-4357-4b2a-b444-b80b5f7e07e9"
      }
    },
    "owner": "brunocorreas"
  }
}
