generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           String        @id @default(cuid())
  nome         String
  email        String        @unique
  senha        String
  plano        Plano         @default(GRATUITO)
  pagamento    Pagamento?
  statusConta  StatusConta   @default(PENDENTE)
  nivelAcesso  NivelAcesso   @default(USUARIO)
  notificacoes Notificacao[]
  tarefas      Tarefa[]
  tokens       Token[]
  logs         Log[]
  pushToken    PushToken[]

  @@map("usuarios")
}

model Tarefa {
  id           String        @id @default(cuid())
  usuarioId    String
  titulo       String
  descricao    String?
  prazoInic    DateTime?
  prazoFim     DateTime?
  prioridade   Prioridade    @default(MEDIA)
  status       StatusTarefa  @default(EM_ANDAMENTO)
  dicas        String?
  deletadoEm   DateTime?
  arquivadoEm  DateTime?
  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  notificacoes Notificacao[]
  logs         Log[]

  @@map("tarefas")
}

model Notificacao {
  id         String   @id @default(cuid())
  usuarioId  String
  tarefaId   String
  data       DateTime @default(now())
  vencimento DateTime
  visualizada Boolean  @default(false)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tarefa     Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  logs       Log[]

  @@map("notificacoes")
}

model PushToken {
  id          String   @id @default(cuid())
  usuarioId   String
  token       String   @unique
  plataforma  String
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

model Token {
  id        String    @id @default(cuid())
  usuarioId String
  token     String    @unique
  tipoToken TipoToken
  criado    DateTime  @default(now())
  expira    DateTime
  revogado  Boolean   @default(false)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model Log {
  id            String       @id @default(cuid())
  criadoEm      DateTime     @default(now())
  tarefaId      String?      @map("tarefa_id")
  notificacaoId String?      @map("notificacao_id")
  usuarioId     String?      @map("usuario_id")
  tarefa        Tarefa?      @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  notificacao   Notificacao? @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  // Campos adicionais para armazenar informações do log erro dos usuarios
  usuarioNome    String?
  erro           String?
  onde           String
  sessao         String?
  nivel          String      @default("error")
  stack          String?
  rota           String?
  metodo         String?
    
  @@index([criadoEm])
  @@index([usuarioId])
  @@map("logs")
}

enum Plano {
  GRATUITO
  MENSAL
  ANUAL
}

enum NivelAcesso {
  ADMIN
  USUARIO
}

enum Pagamento {
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
  GOOGLE_PLAY
}

enum StatusConta {
  ATIVA
  PENDENTE
  BANIDA
}

enum StatusTarefa {
  EM_ANDAMENTO
  CONCLUIDA
  EM_ATRASO
}

enum Prioridade {
  ALTA
  MEDIA
  BAIXA
}

enum TipoToken {
  ATUALIZAR
  REDEFINIR_SENHA
  VALIDACAO_EMAIL
}
